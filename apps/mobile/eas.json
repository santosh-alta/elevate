{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "autoIncrement": true,
      "node": "22.13.0"
    },
    "altaschool": {
      "extends": "base",
      "env": {
        "BRAND": "altaschool"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "altaschool-apk": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "BRAND": "altaschool"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "sunstone": {
      "extends": "base",
      "env": {
        "BRAND": "sunstone"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "mirai": {
      "extends": "base",
      "env": {
        "BRAND": "mirai"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "BRAND": "altaschool"
      }
    }
  },
  "submit": {
    "altaschool": {
      "android": {
        "track": "production",
        "releaseStatus": "completed",
        "serviceAccountKeyPath": "./play-service-account.json"
      }
    },
    "sunstone": {},
    "mirai": {}
  }
}

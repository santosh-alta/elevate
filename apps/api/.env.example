DATABASE_URL=postgresql://elevate:elevate@localhost:5432/elevate
JWT_SECRET=change-me
PORT=4000
# Public URL of this API (used in certificate verification links etc.)
API_PUBLIC_URL=http://localhost:4000
# Hostname brands CNAME their custom domain to
CNAME_TARGET=domains.elevate.app
# Optional: enables AI-written LinkedIn drafts
ANTHROPIC_API_KEY=
# Public URL of the web app, used in emails when a brand has no verified custom domain
WEB_PUBLIC_URL=
# Email: SMTP connection string, e.g. smtps://user:pass@smtp.example.com:465 (without it, emails are logged in dev)
SMTP_URL=
MAIL_FROM=Elevate <no-reply@elevate.app>
# File storage: "local" (default) writes to STORAGE_DIR and serves /v1/files/*; "s3" is planned
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# Set to "off" to disable the in-process notification worker (e.g. when running several API instances)
WORKER=on

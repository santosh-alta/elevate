import { createHash, randomBytes } from "node:crypto";
import { buildApp } from "./src/app";
import { prisma } from "./src/plugins/prisma";
const app = await buildApp(); await app.ready();
const r0 = await app.inject({ method: "POST", url: "/mcp/altaschool", payload: {} });
console.log("1 no token:", r0.statusCode, r0.headers["www-authenticate"]);
console.log("2 PRM:", (await app.inject({ url: "/.well-known/oauth-protected-resource/mcp/altaschool" })).json());
console.log("  AS:", Object.keys((await app.inject({ url: "/.well-known/oauth-authorization-server" })).json()).join(","));
const reg = (await app.inject({ method: "POST", url: "/oauth/register", payload: { client_name: "Claude (test)", redirect_uris: ["https://claude.ai/api/mcp/auth_callback"] } })).json();
console.log("3 register:", reg.client_id?.slice(0, 6));
const verifier = randomBytes(32).toString("base64url");
const challenge = createHash("sha256").update(verifier).digest("base64url");
const az = await app.inject({ url: `/oauth/authorize?response_type=code&client_id=${reg.client_id}&redirect_uri=${encodeURIComponent("https://claude.ai/api/mcp/auth_callback")}&code_challenge=${challenge}&code_challenge_method=S256&state=xyz&scope=platform&resource=${encodeURIComponent("https://events-api-f4od.onrender.com/mcp/altaschool")}` });
const loc = String(az.headers.location); console.log("4 authorize:", az.statusCode, loc.replace(/req=.*/, "req=…"));
const reqId = new URL(loc).searchParams.get("req")!;
const u = await prisma.user.findUniqueOrThrow({ where: { email: "santosh@altaschool.tech" } });
const H = { authorization: `Bearer ${app.jwt.sign({ sub: u.id })}`, "x-tenant": "altaschool" };
console.log("5 consent info:", (await app.inject({ url: `/v1/oauth/requests/${reqId}`, headers: H })).json());
const dec = (await app.inject({ method: "POST", url: `/v1/oauth/requests/${reqId}/decision`, headers: { ...H, "content-type": "application/json" }, payload: { allow: true } })).json();
const code = new URL(dec.redirect).searchParams.get("code")!; console.log("6 decision → state", new URL(dec.redirect).searchParams.get("state"));
const bad = await app.inject({ method: "POST", url: "/oauth/token", headers: { "content-type": "application/x-www-form-urlencoded" }, payload: `grant_type=authorization_code&code=${code}&code_verifier=wrong&client_id=${reg.client_id}` });
console.log("7a wrong verifier:", bad.statusCode, bad.json().error);
// code is single-use: issue a fresh one for the real exchange
const az2 = await app.inject({ url: `/oauth/authorize?response_type=code&client_id=${reg.client_id}&redirect_uri=${encodeURIComponent("https://claude.ai/api/mcp/auth_callback")}&code_challenge=${challenge}&code_challenge_method=S256&state=s2&resource=${encodeURIComponent("https://x/mcp/altaschool")}` });
const req2 = new URL(String(az2.headers.location)).searchParams.get("req")!;
const dec2 = (await app.inject({ method: "POST", url: `/v1/oauth/requests/${req2}/decision`, headers: { ...H, "content-type": "application/json" }, payload: { allow: true } })).json();
const tok = (await app.inject({ method: "POST", url: "/oauth/token", headers: { "content-type": "application/x-www-form-urlencoded" }, payload: `grant_type=authorization_code&code=${new URL(dec2.redirect).searchParams.get("code")}&code_verifier=${verifier}&client_id=${reg.client_id}&redirect_uri=${encodeURIComponent("https://claude.ai/api/mcp/auth_callback")}` })).json();
console.log("7 token:", tok.token_type, tok.expires_in, !!tok.refresh_token);
const mcp = async (body: unknown, token = tok.access_token) => app.inject({ method: "POST", url: "/mcp/altaschool", headers: { authorization: `Bearer ${token}`, "content-type": "application/json", accept: "application/json, text/event-stream" }, payload: JSON.stringify(body) });
const init = await mcp({ jsonrpc: "2.0", id: 1, method: "initialize", params: { protocolVersion: "2025-06-18", capabilities: {}, clientInfo: { name: "test", version: "1" } } });
console.log("8 initialize:", init.statusCode, init.json().result?.serverInfo, init.json().result?.instructions?.slice(0, 90));
const list = (await mcp({ jsonrpc: "2.0", id: 2, method: "tools/list" })).json();
console.log("  tools:", list.result?.tools?.map((t: { name: string }) => t.name).join(", "));
const call = async (name: string, args: unknown) => { const r = (await mcp({ jsonrpc: "2.0", id: 3, method: "tools/call", params: { name, arguments: args } })).json(); return (r.result?.isError ? "ERR " : "") + (r.result?.content?.[0]?.text ?? JSON.stringify(r.error)).slice(0, 260).replace(/\s+/g, " "); };
console.log("  whoami:", await call("whoami", {}));
console.log("  list_events:", await call("list_events", { limit: 2, past: true }));
console.log("  endpoints:", await call("list_api_endpoints", { filter: "judg" }));
console.log("  call_api:", await call("call_api", { method: "GET", path: "/campuses" }));
console.log("  bad path:", await call("call_api", { method: "GET", path: "/../oauth/token" }));
const ref = (await app.inject({ method: "POST", url: "/oauth/token", headers: { "content-type": "application/json" }, payload: JSON.stringify({ grant_type: "refresh_token", refresh_token: tok.refresh_token, client_id: reg.client_id }) })).json();
const reuse = await app.inject({ method: "POST", url: "/oauth/token", headers: { "content-type": "application/json" }, payload: JSON.stringify({ grant_type: "refresh_token", refresh_token: tok.refresh_token }) });
console.log("9 refresh:", !!ref.access_token, "reuse old refresh →", reuse.statusCode);
const conns = (await app.inject({ url: "/v1/me/connections", headers: H })).json();
console.log("10 connections:", conns.mcpUrl, conns.connections.length);
for (const c of conns.connections) await app.inject({ method: "DELETE", url: `/v1/me/connections/${c.id}`, headers: H });
console.log("  after revoke:", (await mcp({ jsonrpc: "2.0", id: 9, method: "tools/list" }, ref.access_token)).statusCode);
await prisma.oAuthClient.delete({ where: { id: reg.client_id } });
await app.close(); await prisma.$disconnect();

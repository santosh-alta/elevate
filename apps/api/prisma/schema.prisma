// Elevate — multi-tenant event operations platform.
// Every tenant-owned table carries `tenantId`. The API always scopes queries by it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Tenancy ─────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique // "sunstone", "altaschool", "mirai"
  name      String
  /// Theme tokens: { colors: {primary, primaryFg, accent, bg, fg, muted, card}, logoUrl, faviconUrl, font, radius }
  theme     Json     @default("{}")
  /// Brand settings: { hashtags: string[], linkedinOrgUrl, emailFrom, supportEmail, social: {...} }
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains         TenantDomain[]
  campuses        Campus[]
  siteFeedback    SiteFeedback[]
  memberships     Membership[]
  events          Event[]
  certTemplates   CertificateTemplate[]
  taskTemplates   TaskTemplate[]
  guestProfiles   GuestProfile[]
  notifications   Notification[]
  judgingPresets  JudgingPreset[]
  eventCategories EventCategory[]
}

model TenantDomain {
  id                String    @id @default(cuid())
  tenantId          String
  hostname          String    @unique // "event.sunstone.in"
  isPrimary         Boolean   @default(false)
  verificationToken String    @default(cuid())
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Campus {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  city      String?
  address   String?
  /// Main campus photo for the campus page and cards
  photoUrl  String?
  /// Public campus profile: { university, state, about, approvals: string[], programme, websiteUrl, gallery: string[] }
  details   Json?
  createdAt DateTime @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  events      EventCampus[]

  @@unique([tenantId, code])
}

// ───────────────────────────── People ─────────────────────────────

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  phone           String?
  avatarUrl       String?
  linkedinUrl     String?
  githubUrl       String?
  /// College, university or organisation
  college         String?
  /// Course or degree, e.g. "B.Tech CSE"
  degree          String?
  graduationYear  Int?
  city            String?
  portfolioUrl    String?
  /// Set when the person has filled in the one-time profile page after first sign-in
  profileCompletedAt DateTime?
  isPlatformAdmin Boolean  @default(false)
  /// Google account id ("sub") once the user has signed in with Google
  googleSub       String?  @unique
  /// GitHub account id once the user has signed in with GitHub
  githubId        String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships      Membership[]
  ownedEvents      Event[]           @relation("EventOwner")
  registrations    Registration[]
  teamMemberships  TeamMember[]
  judgeAssignments JudgeAssignment[]
  scores           Score[]
  certificates     Certificate[]
  linkedinPosts    LinkedInPost[]
  assignedTasks    EventTask[]       @relation("TaskAssignee")
  activities       EventActivity[]
  otpCodes         OtpCode[]
  staffRoles       EventStaff[]
  notifications    Notification[]
  hostedGuests     EventGuest[]      @relation("GuestHost")
  judgeReviews     JudgeReview[]     @relation("JudgeReviews")
  payments         Payment[]
}

enum Role {
  BRAND_ADMIN
  CAMPUS_ADMIN
  EVENT_MANAGER
  JUDGE
  VOLUNTEER
  SPEAKER
  STUDENT
  /// Reviews and approves events submitted by organizers; can edit any event
  MODERATOR
  /// Can create event pages; they stay hidden until an admin or moderator approves them
  ORGANIZER
}

/// Review state of an event page. Staff-created events are APPROVED from the start.
enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

model Membership {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(STUDENT)
  campusId  String?
  batch     String? // e.g. "2025-29"
  rollNo    String?
  /// Work teams this staff member belongs to, e.g. ["SOCIAL_MEDIA"] (see WORK_TEAMS)
  teams     String[] @default([])
  /// Teams this person leads (CC'd on that team's task emails); always a subset of teams
  leadTeams String[] @default([])
  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([tenantId, userId])
  @@index([tenantId, role])
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Events ─────────────────────────────

enum EventType {
  HACKATHON
  SEMINAR
  WORKSHOP
  GUEST_LECTURE
  COMPETITION
  BOOTCAMP
  WEBINAR
  CULTURAL
  ENTREPRENEURSHIP
  STARTUP_PITCH
  CONFERENCE
  PANEL_DISCUSSION
  MEETUP
  CAREER_FAIR
  INDUSTRY_VISIT
  ORIENTATION
  ALUMNI_MEET
  SPORTS
  TECH_FEST
  INDUSTRY_SEMINAR
  CODING_CONTEST
  QUIZ
  OTHER
}

enum EventScope {
  CENTRAL
  CAMPUS
}

enum EventMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PLANNING
  ANNOUNCED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  LIVE
  JUDGING
  COMPLETED
  ARCHIVED
  CANCELLED
}

model Event {
  id                   String      @id @default(cuid())
  tenantId             String
  slug                 String
  title                String
  tagline              String?
  description          String?
  type                 EventType
  scope                EventScope  @default(CENTRAL)
  mode                 EventMode   @default(OFFLINE)
  status               EventStatus @default(DRAFT)
  coverImageUrl        String?
  venue                String?
  meetingUrl           String?
  startsAt             DateTime
  endsAt               DateTime
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  capacity             Int?
  requiresApproval     Boolean     @default(false)
  /// Enabled modules: { teams, judging, submissions, guests, checkin, certificates, feedback, budget }
  modules              Json        @default("{}")
  /// Hackathon config: { minTeamSize, maxTeamSize, tracks: [{id,name,description}], prizes: [...] }
  config               Json        @default("{}")
  /// Custom registration questions: [{ id, label, type, required, options? }]
  registrationForm     Json        @default("[]")
  driveFolderUrl       String?
  livestreamUrl        String?
  venueMapUrl          String?
  contactEmail         String?
  contactPhone         String?
  /// [{ q, a }]
  faqs                 Json        @default("[]")
  /// Secret token that lets staff share a preview of a DRAFT/PLANNING event page
  previewToken         String      @unique @default(cuid())
  clonedFromId         String?
  /// Fests: a sub-event points at its umbrella event (e.g. a hackathon inside a tech fest)
  parentEventId        String?
  /// Brand's own event type (e.g. "Founder Friday"); behaves like `type`
  categoryId           String?
  /// Free tags for filtering and reports, e.g. ["AI", "Placement"]
  tags                 String[]    @default([])
  /// Extra page sections written in the rich-text editor: [{ id, title, html, icon? }] (rules, prizes, timeline, eligibility...)
  pageSections         Json        @default("[]")
  /// Registration fee in the smallest currency unit (paise). 0 or null = free
  feeAmount            Int?
  currency             String      @default("INR")
  feeType              FeeType     @default(PER_PERSON)
  earlyBirdAmount      Int?
  earlyBirdEndsAt      DateTime?
  submissionsOpenAt    DateTime?
  submissionsCloseAt   DateTime?
  resultsPublishedAt   DateTime?
  /// Cached outcome summary, regenerated on demand
  outcome              Json?
  createdById          String?
  /// Who is accountable for the event (defaults to its creator; admins can reassign)
  ownerId              String?
  owner                User?       @relation("EventOwner", fields: [ownerId], references: [id])
  /// Organizer-created events must be approved before they can be published
  approvalStatus       ApprovalStatus @default(APPROVED)
  /// Reviewer's note, shown to the organizer (e.g. why it was sent back)
  approvalNote         String?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewedById         String?
  /// Whether this event may charge a fee (off for organizer events until an admin allows it)
  paidAllowed          Boolean     @default(true)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campuses          EventCampus[]
  sessions          EventSession[]
  staff             EventStaff[]
  tasks             EventTask[]
  guests            EventGuest[]
  registrations     Registration[]
  teams             Team[]
  rubric            RubricCriterion[]
  rounds            JudgingRound[]
  judges            JudgeAssignment[]
  media             MediaAsset[]
  socialPosts       SocialPost[]
  certificates      Certificate[]
  linkedinPosts     LinkedInPost[]
  feedback          Feedback[]
  expenses          Expense[]
  activities        EventActivity[]
  announcements     Announcement[]
  sponsors          Sponsor[]
  notifications     Notification[]
  parentEvent       Event?             @relation("FestChildren", fields: [parentEventId], references: [id], onDelete: SetNull)
  subEvents         Event[]            @relation("FestChildren")
  problemStatements ProblemStatement[]
  payments          Payment[]
  coupons           Coupon[]
  reviews           JudgeReview[]
  category          EventCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tags], type: Gin)
  @@index([tenantId, status])
  @@index([tenantId, startsAt])
}

model EventCampus {
  eventId  String
  campusId String

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@id([eventId, campusId])
}

model EventSession {
  id       String   @id @default(cuid())
  eventId  String
  title    String
  speaker  String?
  startsAt DateTime
  endsAt   DateTime
  location String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

/// Event-level role assignment (manager, volunteer, photographer, mentor, ...)
model EventStaff {
  id      String @id @default(cuid())
  eventId String
  userId  String
  role    String // "MANAGER" | "VOLUNTEER" | "PHOTOGRAPHER" | "MENTOR" | "SOCIAL"

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, role])
}

// ───────────────────────────── Planning ─────────────────────────────

enum TaskPhase {
  PRE
  DURING
  POST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
  SKIPPED
}

/// Brand-editable checklist template per event type
model TaskTemplate {
  id            String    @id @default(cuid())
  tenantId      String
  eventType     EventType
  phase         TaskPhase
  title         String
  /// Due date offset in days relative to event start (negative = before)
  dueOffsetDays Int       @default(0)
  sortOrder     Int       @default(0)
  team          String?
  proofRequired Boolean   @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType])
}

model EventTask {
  id          String     @id @default(cuid())
  eventId     String
  phase       TaskPhase
  title       String
  notes       String?
  status      TaskStatus @default(TODO)
  dueAt       DateTime?
  assigneeId  String?
  completedAt DateTime?
  sortOrder   Int        @default(0)
  /// Optional evidence link (poster, drive, booking confirmation)
  evidenceUrl String?
  /// Team responsible (OWNER, OPERATIONS, SOCIAL_MEDIA)
  team          String?
  /// evidenceUrl must be set before the task can be marked done
  proofRequired Boolean @default(false)

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([eventId, phase])
}

enum GuestStatus {
  PROPOSED
  INVITED
  CONFIRMED
  DECLINED
  ARRIVED
  THANKED
}

/// Reusable guest/speaker profile at brand level (the guest "file"), linked to each event they attend.
model GuestProfile {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  email        String?
  phone        String?
  designation  String?
  organization String?
  bio          String?
  photoUrl     String?
  linkedinUrl  String?
  websiteUrl   String?
  city         String?
  expertise    String[] @default([])
  /// Internal notes (relationship history, preferences). Never public.
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appearances EventGuest[]

  @@index([tenantId, name])
}

model EventGuest {
  id                 String      @id @default(cuid())
  eventId            String
  profileId          String?
  name               String
  email              String?
  phone              String?
  designation        String?
  organization       String?
  bio                String?
  photoUrl           String?
  linkedinUrl        String?
  role               String      @default("SPEAKER") // SPEAKER | CHIEF_GUEST | PANELIST | JUDGE | MENTOR | INVESTOR | MODERATOR
  status             GuestStatus @default(PROPOSED)
  // Session
  talkTitle          String?
  talkAbstract       String?
  sessionAt          DateTime?
  // Logistics
  hostUserId         String? // point of contact from our side
  arrivalAt          DateTime?
  departureAt        DateTime?
  travelNotes        String?
  stayDetails        String?
  dietary            String?
  avRequirements     String?
  consentRecording   Boolean?
  // Payment and courtesy
  honorarium         Decimal?    @db.Decimal(12, 2)
  paymentStatus      String? // NOT_APPLICABLE | PENDING | PAID
  invoiceUrl         String?
  mementoGiven       Boolean     @default(false)
  invitedAt          DateTime?
  thankYouSentAt     DateTime?
  /// [{ name, url, kind }] e.g. ID proof, invoice, presentation
  documents          Json        @default("[]")
  /// Guest self-service portal (/guest/<token>) to fill their own profile
  portalToken        String      @unique @default(cuid())
  profileSubmittedAt DateTime?
  isPublic           Boolean     @default(true)
  sortOrder          Int         @default(0)
  createdAt          DateTime    @default(now())

  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  profile      GuestProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  host         User?         @relation("GuestHost", fields: [hostUserId], references: [id])
  certificates Certificate[]
}

model Sponsor {
  id        String  @id @default(cuid())
  eventId   String
  name      String
  logoUrl   String?
  website   String?
  tier      String  @default("PARTNER") // TITLE | GOLD | SILVER | PARTNER | COMMUNITY
  sortOrder Int     @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String    @id @default(cuid())
  eventId   String
  title     String
  body      String
  channels  String[] // ["EMAIL", "PUSH", "WHATSAPP", "IN_APP"]
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Participation ─────────────────────────────

enum RegistrationStatus {
  PENDING_PAYMENT
  REGISTERED
  APPROVED
  WAITLISTED
  REJECTED
  CANCELLED
  CHECKED_IN
  NO_SHOW
}

model Registration {
  id            String             @id @default(cuid())
  eventId       String
  userId        String
  status        RegistrationStatus @default(REGISTERED)
  answers       Json               @default("{}")
  ticketCode    String             @unique @default(cuid())
  checkedInAt   DateTime?
  checkedInById String?
  /// Set when a team leader registered this person as part of their team
  addedById     String?
  paymentId     String?
  createdAt     DateTime           @default(now())

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId, status])
}

model Team {
  id                 String    @id @default(cuid())
  eventId            String
  name               String
  inviteCode         String    @unique
  trackId            String?
  problemStatementId String?
  /// Registered as a team on the registration form (leader filled in the members)
  registeredAsTeam   Boolean   @default(false)
  // Submission
  projectTitle       String?
  projectSummary     String?
  repoUrl            String?
  demoUrl            String?
  deckUrl            String?
  videoUrl           String?
  /// Extra links and uploaded files: [{ label, url, kind: "link" | "file" }]
  attachments        Json      @default("[]")
  techStack          String[]  @default([])
  submittedAt        DateTime?
  // Result
  rank               Int?
  award              String? // "WINNER" | "RUNNER_UP" | "SECOND_RUNNER_UP" | "SPECIAL_MENTION"
  createdAt          DateTime  @default(now())

  event            Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members          TeamMember[]
  scores           Score[]
  judgeAssignments JudgeAssignment[]
  problemStatement ProblemStatement? @relation(fields: [problemStatementId], references: [id], onDelete: SetNull)
  roundEntries     RoundTeam[]
  reviews          JudgeReview[]
  payments         Payment[]

  @@unique([eventId, name])
}

model TeamMember {
  teamId   String
  userId   String
  isLeader Boolean  @default(false)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

// ───────────────────────────── Judging ─────────────────────────────

model RubricCriterion {
  id          String  @id @default(cuid())
  eventId     String
  name        String
  description String?
  maxScore    Int     @default(10)
  weight      Float   @default(1)
  sortOrder   Int     @default(0)
  /// null = used in every round; otherwise only in this round
  roundId     String?

  event  Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round  JudgingRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  scores Score[]
}

model JudgingRound {
  id            String    @id @default(cuid())
  eventId       String
  name          String // "Screening", "Finals"
  sortOrder     Int       @default(0)
  isOpen        Boolean   @default(false)
  closedAt      DateTime?
  description   String?
  /// Optional schedule shown to judges; opening is still done by the admin
  opensAt       DateTime?
  closesAt      DateTime?
  /// Only teams listed in RoundTeam are judged in this round (filled by "advance top N"); false = every team
  restrictTeams Boolean   @default(false)
  /// Teams can see judges' comments and their scores for this round after it closes
  shareFeedback Boolean   @default(false)

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scores      Score[]
  assignments JudgeAssignment[]
  criteria    RubricCriterion[]
  teams       RoundTeam[]
  reviews     JudgeReview[]
}

/// A team qualified for a judging round (shortlist).
model RoundTeam {
  roundId String
  teamId  String
  addedAt DateTime @default(now())

  round JudgingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([roundId, teamId])
}

/// A judge's overall remarks for one team in one round (besides per-criterion scores).
model JudgeReview {
  id          String    @id @default(cuid())
  eventId     String
  roundId     String
  teamId      String
  judgeId     String
  comment     String?
  /// Suggested remarks the judge ticked, e.g. "Strong demo", "Needs clearer problem statement"
  tags        String[]  @default([])
  /// Judge recommends this team for the next round
  recommend   Boolean?
  submittedAt DateTime?
  updatedAt   DateTime  @updatedAt

  event Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round JudgingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judge User         @relation("JudgeReviews", fields: [judgeId], references: [id], onDelete: Cascade)

  @@unique([roundId, teamId, judgeId])
}

enum JudgingPresetKind {
  CRITERION
  COMMENT
}

/// Brand-level library of judging parameters and suggested comments (on top of the built-in defaults).
model JudgingPreset {
  id          String            @id @default(cuid())
  tenantId    String
  kind        JudgingPresetKind
  name        String
  description String?
  maxScore    Int?
  weight      Float?
  /// Free label for grouping: "Technical", "Business", "Positive", "Improve"
  category    String?
  createdAt   DateTime          @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, kind])
}

model ProblemStatement {
  id          String    @id @default(cuid())
  eventId     String
  trackId     String?
  code        String? // "PS-01"
  title       String
  /// Rich text (sanitised HTML)
  html        String    @default("")
  difficulty  String?
  sponsorName String?
  /// [{ label, url }]
  attachments Json      @default("[]")
  /// Hidden from participants until this time (online hackathons reveal at kickoff)
  releaseAt   DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teams Team[]
}

// ───────────────────────────── Payments ─────────────────────────────

enum FeeType {
  PER_PERSON
  PER_TEAM
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  MANUAL
  DEV
}

model Payment {
  id                String          @id @default(cuid())
  eventId           String
  userId            String
  teamId            String?
  provider          PaymentProvider @default(RAZORPAY)
  status            PaymentStatus   @default(CREATED)
  /// Smallest currency unit (paise)
  amount            Int
  currency          String          @default("INR")
  /// Seats paid for (team members for a per-person fee)
  quantity          Int             @default(1)
  couponId          String?
  discount          Int             @default(0)
  providerOrderId   String?         @unique
  providerPaymentId String?
  receiptNo         String          @unique
  paidAt            DateTime?
  refundedAt        DateTime?
  expiresAt         DateTime?
  notes             String?
  raw               Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  coupon        Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  registrations Registration[]

  @@index([eventId, status])
}

model Coupon {
  id         String    @id @default(cuid())
  eventId    String
  code       String
  percentOff Int?
  amountOff  Int?
  maxUses    Int?
  usedCount  Int       @default(0)
  validUntil DateTime?
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([eventId, code])
}

/// A judge on an event. If teamId is null the judge scores every team in the round.
model JudgeAssignment {
  id      String  @id @default(cuid())
  eventId String
  userId  String
  roundId String?
  teamId  String?

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  round JudgingRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team  Team?         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, roundId, teamId])
}

model Score {
  id          String    @id @default(cuid())
  roundId     String
  teamId      String
  judgeId     String
  criterionId String
  value       Float
  comment     String?
  submittedAt DateTime? // null = draft, set = locked
  updatedAt   DateTime  @updatedAt

  round     JudgingRound    @relation(fields: [roundId], references: [id], onDelete: Cascade)
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  judge     User            @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([roundId, teamId, judgeId, criterionId])
}

// ───────────────────────────── Media & social ─────────────────────────────

enum MediaKind {
  PHOTO_ALBUM
  PHOTO
  VIDEO
  POSTER
  GUEST_PHOTO
  DECK
  REPORT
  OTHER
}

model MediaAsset {
  id                String    @id @default(cuid())
  eventId           String
  kind              MediaKind
  title             String?
  url               String // Drive link or storage URL
  caption           String?
  storageKey        String? // set when uploaded to our storage
  mimeType          String?
  sizeBytes         Int?
  isHighlight       Boolean   @default(false)
  approvedForSocial Boolean   @default(false)
  uploadedById      String?
  createdAt         DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

enum SocialPlatform {
  LINKEDIN
  INSTAGRAM
  X
  FACEBOOK
  YOUTUBE
  WHATSAPP
}

enum SocialPostStatus {
  PLANNED
  DRAFTED
  POSTED
}

model SocialPost {
  id          String           @id @default(cuid())
  eventId     String
  platform    SocialPlatform
  status      SocialPostStatus @default(PLANNED)
  caption     String?
  generatedBy String? // "template" | "ai" | null (manual)
  url         String?
  ownerId     String?
  postedAt    DateTime?
  /// Filled later: { impressions, likes, comments, shares }
  metrics     Json?
  /// Shown as an embedded preview on the public event page ("From the community")
  featured    Boolean          @default(false)
  /// Who posted it, e.g. a participant's name (official posts leave this empty)
  authorName  String?
  createdAt   DateTime         @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Certificates & LinkedIn ─────────────────────────────

enum CertificateType {
  PARTICIPATION
  FINALIST
  WINNER
  RUNNER_UP
  SPECIAL_MENTION
  JUDGE
  SPEAKER
  VOLUNTEER
  MENTOR
}

model CertificateTemplate {
  id        String          @id @default(cuid())
  tenantId  String
  type      CertificateType
  /// { backgroundUrl, title, bodyTemplate: "This is to certify that {{name}} ...", signatories: [{name, title, signatureUrl}] }
  design    Json
  createdAt DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, type])
}

model Certificate {
  id            String          @id @default(cuid())
  eventId       String
  userId        String?
  guestId       String?
  type          CertificateType
  serial        String          @unique // human-friendly verification code
  recipientName String
  detail        String? // "Winner — Team Byte Me"
  pdfUrl        String?
  issuedAt      DateTime        @default(now())
  revokedAt     DateTime?

  event Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  guest EventGuest? @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId, type])
  @@unique([eventId, guestId, type])
}

enum LinkedInPostStatus {
  SUGGESTED
  EDITED
  POSTED
  SKIPPED
}

model LinkedInPost {
  id          String             @id @default(cuid())
  eventId     String
  userId      String
  draft       String
  generatedBy String             @default("template") // "template" | "ai"
  status      LinkedInPostStatus @default(SUGGESTED)
  postUrl     String?
  postedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

// ───────────────────────────── Feedback, budget, audit ─────────────────────────────

model Feedback {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  rating    Int // 1-5
  nps       Int? // 0-10
  comment   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model Expense {
  id          String   @id @default(cuid())
  eventId     String
  category    String // VENUE, FOOD, TRAVEL, PRIZES, MARKETING, MEMENTO, OTHER
  description String
  planned     Decimal  @default(0) @db.Decimal(12, 2)
  actual      Decimal  @default(0) @db.Decimal(12, 2)
  receiptUrl  String?
  createdAt   DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model EventActivity {
  id        String   @id @default(cuid())
  eventId   String
  actorId   String?
  action    String // "status.changed", "task.done", "media.added", "scores.submitted", ...
  data      Json     @default("{}")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])

  @@index([eventId, createdAt])
}

// ───────────────────────────── Notifications ─────────────────────────────

enum NotificationChannel {
  EMAIL
  IN_APP
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Outbox: every message is a row; a worker sends due rows. dedupKey prevents duplicates (e.g. one 24h reminder per registration).
model Notification {
  id           String              @id @default(cuid())
  tenantId     String
  eventId      String?
  userId       String?
  toEmail      String?
  channel      NotificationChannel @default(EMAIL)
  template     String // "registration.confirmed", "event.reminder.24h", "guest.invite", ...
  subject      String
  body         String // plain text; HTML is rendered from it with the brand header
  data         Json                @default("{}")
  status       NotificationStatus  @default(PENDING)
  scheduledFor DateTime            @default(now())
  sentAt       DateTime?
  readAt       DateTime?
  error        String?
  attempts     Int                 @default(0)
  dedupKey     String?             @unique
  createdAt    DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  event  Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, channel, createdAt])
}

/// A brand's own event type, e.g. "Founder Friday" (behaves like baseType: same modules, checklist and page sections
/// unless overridden). Shown inside its family in the type picker.
model EventCategory {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  /// One of EVENT_FAMILIES keys in @elevate/shared: TALKS, LEARNING, COMPETITIONS, COMMUNITY, FESTS
  family      String
  baseType    EventType
  description String?
  /// lucide icon name
  icon        String?
  /// Overrides of the base type's default modules, e.g. { "judging": true }
  modules     Json?
  /// Tags added to new events of this type
  defaultTags String[]  @default([])
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events Event[]

  @@unique([tenantId, name])
}

/// Feedback about the site itself (e.g. from students testing it before launch)
model SiteFeedback {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  name      String?
  email     String?
  campus    String?
  /// 1–5
  rating    Int?
  liked     String?
  confusing String?
  missing   String?
  broken    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

/// AI writing help used per person per day (India date), for the daily limit
model AiUsage {
  userId    String
  /// YYYY-MM-DD in India time
  day       String
  tenantId  String
  count     Int      @default(0)
  tokens    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, day])
  @@index([tenantId, day])
}
